FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk add --no-cache \
      age=1.3.2-r1 \
      bash=5.3.9-r1 \
      ca-certificates=20261020-r0 \
      curl=8.22.0-r0 \
      postgresql18-client=18.6-r0 \
      rclone=1.74.1-r3 \
      tar=1.35-r5 \
  && apk upgrade --no-cache ca-certificates ca-certificates-bundle \
  && for package in ca-certificates ca-certificates-bundle; do \
       installed="$(apk info -v --installed "$package" | grep -E "^${package}-[0-9]+-r[0-9]+$")" \
       && version="${installed#${package}-}" \
       && test "$(apk version -t "$version" 20261020-r0)" != '<' \
       && printf '%s\n' "$installed" || exit 1; \
     done \
  && test "$(id -u postgres)" = 70 \
  && test "$(id -g postgres)" = 70 \
  && mkdir -p /opt/exp \
  && pg_dump --version \
  && pg_restore --version \
  && age --version \
  && rclone version
ENV HOME=/tmp
USER 70:70
WORKDIR /tmp
# The host provides this reviewed script through a read-only bind mount.
# TODO(emudhra-2026-10): retain the CA minimum and TLS controls until refreshed bases pass the same probes.
# Build-time egress is required (L3 accepted). The R2 control is a public host, not a private bucket.
RUN <<'TLS_CHECK'
set -eu
bad=https://dv-g3b-emudhra.we-have-a-problem.com/
r2=https://docker-images-prod.6aa30f8b08e16409b46e0173d6de2f56.r2.cloudflarestorage.com/
code=0
message=$(curl --connect-timeout 10 --max-time 20 -sS -o /dev/null "$bad" 2>&1) || code=$?
printf '%s\n' "$message"
test "$code" = 60
printf 'BACKUP_EMUDHRA_CURL_REJECT exit %s\n' "$code"
code=0
message=$(timeout 30s rclone lsf --config /dev/null --http-url "$bad" :http: --contimeout 10s --timeout 20s --retries 1 --low-level-retries 1 --log-level ERROR 2>&1) || code=$?
printf '%s\n' "$message"
test "$code" != 0 && test "$code" != 124
printf '%s\n' "$message" | grep -Eq 'x509: certificate signed by unknown authority|failed to verify certificate'
echo 'BACKUP_EMUDHRA_RCLONE_REJECT x509'
status=$(curl --connect-timeout 10 --max-time 20 -sS -o /dev/null -w '%{http_code}' https://api.github.com/)
printf 'BACKUP_GITHUB_TLS_OK %s\n' "$status"
status=$(curl --connect-timeout 10 --max-time 20 -sS -o /dev/null -w '%{http_code}' "$r2")
printf 'BACKUP_R2_CURL_TLS_OK %s\n' "$status"
code=0
message=$(timeout 30s rclone lsf --config /dev/null --http-url "$r2" :http: --contimeout 10s --timeout 20s --retries 1 --low-level-retries 1 --log-level ERROR 2>&1) || code=$?
printf '%s\n' "$message"
if printf '%s\n' "$message" | grep -Eiq 'x509|TLS|certificate|no such host|dial tcp|timeout|timed out|connection refused'; then exit 1; fi
if test "$code" != 0; then
  test "$code" != 124
  printf '%s\n' "$message" | grep -Eq '(^|[^0-9])[45][0-9][0-9] (Bad Request|Unauthorized|Forbidden|Not Found|Method Not Allowed|[A-Za-z][A-Za-z ]+)'
fi
echo 'BACKUP_R2_RCLONE_TLS_OK'
TLS_CHECK
CMD ["/opt/exp/backup.sh"]
