FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS build
WORKDIR /app
RUN npm install -g npm@11.12.1
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY apps/cli/package.json ./apps/cli/package.json
COPY apps/mcp/package.json ./apps/mcp/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY apps/site/package.json ./apps/site/package.json
COPY packages/auth/package.json ./packages/auth/package.json
COPY packages/core/package.json ./packages/core/package.json
COPY packages/skill-package/package.json ./packages/skill-package/package.json
RUN npm ci
COPY tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
COPY scripts ./scripts
ARG VITE_API_BASE_URL=/api
ARG MYSKILLS_BUILD_REVISION
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN test "${VITE_API_BASE_URL}" = /api \
  && npm run build -w @myskills-app/core \
  && npm run build -w @myskills-app/web \
  && MYSKILLS_BUILD_REVISION=${MYSKILLS_BUILD_REVISION} node scripts/write-build-info.mjs apps/web/dist/version.json

FROM nginxinc/nginx-unprivileged:stable-alpine@sha256:f5116ed4606f3eb015dd4a8e28cb9b351476dc0ad4bc6e9f93b19cec130cdf03 AS web
COPY ops/exp/nginx.conf /opt/exp/nginx.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
USER 101:101
EXPOSE 8080
# Bypass entrypoint scripts and use immutable config outside runtime tmpfs mounts.
ENTRYPOINT ["nginx"]
CMD ["-c", "/opt/exp/nginx.conf", "-g", "daemon off;"]
