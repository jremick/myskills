{
  "name": "@myskills-app/mcp",
  "version": "0.1.0-beta.3",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "myskills-mcp": "./dist/index.js",
    "myskills-mcp-http": "./dist/http-index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "dev:http": "node --env-file-if-exists=../../.env --import tsx src/http-index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "start:http": "node --env-file-if-exists=../../.env dist/http-index.js",
    "test": "node ../../scripts/run-node-tests.mjs --import tsx --extensions .test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@myskills-app/core": "0.1.0-beta.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
