{
  "name": "@myskills-app/mcp",
  "version": "0.1.0-beta.6",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "myskills-mcp": "./dist/index.js",
    "myskills-mcp-http": "./dist/http-index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "dev:http": "node --env-file-if-exists=../../.env --import tsx src/http-index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "start:http": "node --env-file-if-exists=../../.env dist/http-index.js",
    "test": "node ../../scripts/run-node-tests.mjs --import tsx --extensions .test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.1.0",
    "@myskills-app/core": "0.1.0-beta.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
