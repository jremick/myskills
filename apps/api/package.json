{
  "name": "@myskills-app/api",
  "version": "0.1.0-beta.4",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env --import tsx src/db/seed.ts",
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "test": "node ../../scripts/run-node-tests.mjs --import tsx --extensions .test.ts",
    "test:postgres": "node -e \"if (!process.env.TEST_DATABASE_URL) { console.error('TEST_DATABASE_URL is required.'); process.exit(1); }\" && node ../../scripts/run-node-tests.mjs --import tsx --extensions .pgtest.ts --test-concurrency=1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@myskills-app/auth": "0.1.0-beta.4",
    "@myskills-app/core": "0.1.0-beta.4",
    "@myskills-app/skill-package": "0.1.0-beta.4",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.12.1",
    "nodemailer": "^9.0.6",
    "pg": "^8.23.0",
    "resend": "^6.25.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
