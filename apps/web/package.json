{
  "name": "@myskills-app/web",
  "version": "0.1.0-beta.6",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "node --env-file-if-exists=../../.env ../../node_modules/vite/bin/vite.js --host 0.0.0.0",
    "preview": "node --env-file-if-exists=../../.env ../../node_modules/vite/bin/vite.js preview --host 0.0.0.0",
    "test": "node ../../scripts/run-node-tests.mjs --import tsx --import ./test/setup-dom.ts --test-concurrency=1 --extensions .test.ts,.test.tsx",
    "test:e2e": "playwright test -c playwright.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@myskills-app/core": "0.1.0-beta.6",
    "@radix-ui/react-slot": "^1.3.3",
    "@xyflow/react": "12.11.6",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.1",
    "@types/jsdom": "^27.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^27.3.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
