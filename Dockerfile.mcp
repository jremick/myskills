# syntax=docker/dockerfile:1

ARG NODE_VERSION=22-alpine
ARG NPM_VERSION=11.12.1

FROM node:${NODE_VERSION} AS build
ARG NPM_VERSION
WORKDIR /app
RUN npm install -g npm@${NPM_VERSION}
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY apps/cli/package.json ./apps/cli/package.json
COPY apps/mcp/package.json ./apps/mcp/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY packages/auth/package.json ./packages/auth/package.json
COPY packages/core/package.json ./packages/core/package.json
COPY packages/skill-package/package.json ./packages/skill-package/package.json
RUN npm ci
COPY tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
RUN npm run build -w @myskills-app/core \
  && npm run build -w @myskills-app/skill-package \
  && npm run build -w @myskills-app/mcp
RUN npm prune --omit=dev

FROM node:${NODE_VERSION} AS mcp-http
RUN apk add --no-cache ca-certificates \
  && apk upgrade --no-cache ca-certificates ca-certificates-bundle \
  && for package in ca-certificates ca-certificates-bundle; do \
       installed="$(apk info -v --installed "$package" | grep -E "^${package}-[0-9]+-r[0-9]+$")" \
       && version="${installed#${package}-}" \
       && test "$(apk version -t "$version" 20261020-r0)" != '<' \
       && printf '%s\n' "$installed" || exit 1; \
     done
# TODO(emudhra-2026-10): nodejs/node#66871 has shipped in Node 22.23.4 but is not in Node 24.19.0; keep --use-openssl-ca / SSL_CERT_FILE for now
ENV NODE_OPTIONS="--use-openssl-ca" \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV NODE_ENV=production \
    MYSKILLS_MCP_HOST=0.0.0.0
WORKDIR /app
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/mcp/package.json ./apps/mcp/package.json
COPY --from=build /app/apps/mcp/dist ./apps/mcp/dist
COPY scripts/smoke-mcp-http.mjs ./scripts/smoke-mcp-http.mjs
USER node
RUN node -e "const fs=require('fs'),tls=require('tls'),{X509Certificate}=require('crypto');const bad=new Set(['BC:4D:80:9B:15:18:9D:78:DB:3E:1D:8C:F4:F9:72:6A:79:5D:A1:64:3C:A5:F1:35:8E:1D:DB:0E:DC:0D:7E:B3','86:A1:EC:BA:08:9C:4A:8D:3B:BE:27:34:C6:12:BA:34:1D:81:3E:04:3C:F9:E8:A8:62:CD:5C:57:A3:6B:BE:6B','12:56:09:AA:30:1D:A0:A2:49:B9:7A:82:39:CB:6A:34:21:6F:44:DC:AC:9F:39:54:B1:42:92:F2:E8:C8:60:8F']);if(!process.execArgv.concat((process.env.NODE_OPTIONS||'').split(/\s+/)).includes('--use-openssl-ca'))throw new Error('--use-openssl-ca not active');const file=(fs.readFileSync(process.env.SSL_CERT_FILE,'utf8').match(/-----BEGIN CERTIFICATE-----[\s\S]+?-----END CERTIFICATE-----/g)||[]);const sys=tls.getCACertificates('system');if(file.length<100||sys.length<100)throw new Error('CA store too small: '+file.length+'/'+sys.length);const hit=[...file,...sys].map(c=>new X509Certificate(c)).filter(x=>bad.has(x.fingerprint256));if(hit.length)throw new Error('Distrusted emSign roots present: '+[...new Set(hit.map(x=>x.subject.replace(/\n/g,',')))].join('; '));console.log('EMSIGN_ROOTS_ABSENT file='+file.length+' system='+sys.length)"
EXPOSE 3002
# These runtime-user checks need build-time egress (L3, accepted).
RUN timeout 30s node --use-openssl-ca -e "require('https').get('https://dv-g3b-emudhra.we-have-a-problem.com/',r=>{console.error('EMUDHRA_UNEXPECTED_TLS_OK HTTP '+r.statusCode);process.exit(1)}).on('error',e=>{console.log('EMUDHRA_NEGATIVE '+e.code);process.exit(['UNABLE_TO_GET_ISSUER_CERT_LOCALLY','CERT_REVOKED'].includes(e.code)?0:1)})" \
  && timeout 30s node --use-openssl-ca -e "require('https').get('https://api.resend.com',r=>{console.log('RESEND_TLS_OK HTTP '+r.statusCode);process.exit(0)}).on('error',e=>{console.error(e.code);process.exit(1)})" \
  && timeout 30s node --use-openssl-ca -e "require('https').get('https://api.github.com/',r=>{console.log('GITHUB_TLS_OK HTTP '+r.statusCode);process.exit(0)}).on('error',e=>{console.error(e.code);process.exit(1)})"
CMD ["node", "--use-openssl-ca", "apps/mcp/dist/http-index.js"]
